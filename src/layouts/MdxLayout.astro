---
import BaseLayout from './BaseLayout.astro';
import { PARTS, type Part } from '../data/curriculum';
import { withBase } from '../lib/site';
import { canonicalUrl, learningResourceLd, sectionTitle as seoTitle } from '../lib/seo';
import { langOfUrl, localizePath } from '../i18n';
import { partTitle, sectionTitle, statusLabel } from '../i18n/content';
import { hasEnglishSection, sectionPath } from '../i18n/routes';
import { UI } from '../i18n/ui';

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    /** 커리큘럼 절 ID (예: 'P2-2'). 있으면 경로 표시, Part 사이드바, 이전/다음 절 이동을 붙인다 */
    sectionId?: string;
  };
  /** Astro가 MDX 레이아웃에 넘겨 주는 제목 목록 */
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;

// 언어 (D-054): 영어 절 페이지는 src/pages/en/에 있고 같은 sectionId를 쓴다
const lang = langOfUrl(Astro.url);
const t = UI[lang];
/** 영어 페이지에서 아직 번역 안 된 절은 한국어 페이지로 가고 KO 표시를 붙인다 */
const koOnly = (id: string) => lang === 'en' && !hasEnglishSection(id);

const sections = PARTS.flatMap((part) => part.sections.map((section) => ({ ...section, part })));
const index = frontmatter.sectionId ? sections.findIndex((s) => s.id === frontmatter.sectionId) : -1;
const current = index >= 0 ? sections[index] : undefined;
const prev = index > 0 ? sections[index - 1] : undefined;
const next = index >= 0 ? sections[index + 1] : undefined;
const part: Part | undefined = current?.part;
const href = (s: { id: string; href?: string }) => withBase(sectionPath(s, lang) ?? '/');
/** 이 페이지의 ## 제목 (사이드바의 "이 페이지" 목록) */
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text.replace(/\s+/g, ' ').trim() }));
const lastKey = lang === 'en' ? 'vs-last-section-en-v1' : 'vs-last-section-v3';
const last = current ? JSON.stringify({ id: current.id, title: sectionTitle(current, lang), href: href(current) }) : '';

// 검색 노출 (M12.1): 제목은 주제어 먼저, 경로 표시·학습 자료 구조화 데이터
const site = Astro.site ?? new URL('https://tg-jang03.github.io');
const docTitle = frontmatter.title ? seoTitle(frontmatter.title, frontmatter.sectionId) : undefined;
const crumbs = current
  ? [
      { name: `Part ${current.part.num}. ${partTitle(current.part, lang)}`, path: localizePath(`/parts/${current.part.num}/`, lang) },
      { name: `${current.id} ${sectionTitle(current, lang)}`, path: localizePath(current.href ?? '/', lang) },
    ]
  : undefined;
const jsonLd = current
  ? [
      learningResourceLd({
        name: sectionTitle(current, lang),
        description: frontmatter.description,
        url: canonicalUrl(Astro.url.pathname, site),
        lang,
        kind: 'lesson',
        site: { name: t.siteName, url: new URL(withBase(localizePath('/', lang)), site).href },
      }),
    ]
  : [];
---

<BaseLayout title={docTitle} description={frontmatter.description} wide={!!part} crumbs={crumbs} jsonLd={jsonLd} ogType={current ? 'article' : 'website'}>
  <div class="page-layout" data-has-nav={part ? '' : undefined}>
    {
      part && current && (
        <aside class="part-nav" aria-label={t.partSections(part.num)}>
          <details class="part-nav-box" open>
            <summary>
              <span class="part-nav-kicker">Part {part.num}</span>
              <span class="part-nav-title">{partTitle(part, lang)}</span>
            </summary>
            <ol class="part-nav-list">
              {part.sections.map((s) => {
                const here = s.id === current.id;
                const ko = koOnly(s.id);
                return (
                  <li data-status={ko ? 'planned' : s.status} data-current={here ? '' : undefined}>
                    {s.href ? (
                      <a href={href(s)} aria-current={here ? 'page' : undefined} title={ko ? t.koreanOnlyTitle : `${s.id} · ${statusLabel(s.status, lang)}`}>
                        <span class="nav-dot" aria-hidden="true" />
                        <span class="nav-id">{s.id}</span>
                        <span class="nav-text">
                          {sectionTitle(s, lang)}
                          {ko && <span class="ko-mark">{t.koreanOnly}</span>}
                        </span>
                      </a>
                    ) : (
                      <span class="nav-planned" title={`${s.id} · ${t.comingSoon}`}>
                        <span class="nav-dot" aria-hidden="true" />
                        <span class="nav-id">{s.id}</span>
                        <span class="nav-text">{sectionTitle(s, lang)}</span>
                      </span>
                    )}
                    {here && toc.length > 0 && (
                      <ul class="part-nav-toc" aria-label={t.onThisPage}>
                        {toc.map((h) => (
                          <li>
                            <a href={`#${h.slug}`}>{h.text}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ol>
            <div class="part-nav-parts" aria-label={t.otherParts}>
              {PARTS.map((p) => (
                <a href={withBase(localizePath(`/parts/${p.num}/`, lang))} aria-current={p.num === part.num ? 'true' : undefined} title={`Part ${p.num}. ${partTitle(p, lang)}`}>
                  {p.num}
                </a>
              ))}
            </div>
          </details>
          {/* 좁은 화면에서는 절 목록을 접어 둔다 (넓은 화면은 늘 펼침). 목록 바로 뒤에서 실행해 깜빡임이 없다 */}
          <script is:inline>
            if (window.matchMedia('(max-width: 1199px)').matches) document.querySelector('.part-nav-box')?.removeAttribute('open');
          </script>
        </aside>
      )
    }
    <div class="page-main">
      {
        current && (
          <div class="breadcrumb">
            <a href={withBase(localizePath('/', lang))}>{t.navCurriculum}</a> ›{' '}
            <a href={withBase(localizePath(`/parts/${current.part.num}/`, lang))}>
              Part {current.part.num}. {partTitle(current.part, lang)}
            </a>{' '}
            › {current.id}
          </div>
        )
      }
      <article class="prose">
        <slot />
      </article>
      {
        current && (
          <nav class="section-pager" aria-label={t.sectionPager}>
            {prev ? (
              prev.href ? (
                <a href={href(prev)}>
                  ← {prev.id} {sectionTitle(prev, lang)}
                  {koOnly(prev.id) && <span class="ko-mark">{t.koreanOnly}</span>}
                </a>
              ) : (
                <span class="pager-soon">
                  ← {prev.id} {sectionTitle(prev, lang)} ({t.comingSoon})
                </span>
              )
            ) : (
              <span />
            )}
            {next ? (
              next.href ? (
                <a href={href(next)}>
                  {next.id} {sectionTitle(next, lang)}
                  {koOnly(next.id) && <span class="ko-mark">{t.koreanOnly}</span>} →
                </a>
              ) : (
                <span class="pager-soon">
                  {next.id} {sectionTitle(next, lang)} ({t.comingSoon}) →
                </span>
              )
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </div>
  {
    current && (
      <script is:inline define:vars={{ last, lastKey }}>
        try {
          localStorage.setItem(lastKey, last);
        } catch (e) {}
      </script>
    )
  }
</BaseLayout>
