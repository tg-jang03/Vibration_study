---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { REPO_URL, SITE_NAME, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 사이드바가 있는 절 페이지처럼 넓은 틀이 필요할 때 (기본 false, D-037) */
  wide?: boolean;
}

const {
  title,
  wide = false,
  description = '진동의 물리와 신호처리부터 대형 회전기계(GT/ST) 상태 진단까지 연결하는 기계 진동 학습 아카이브',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname.replace(/\/+$/, '');
const isHome = path === withBase('/').replace(/\/+$/, '');
const isLab = path.startsWith(withBase('/lab').replace(/\/+$/, ''));
const isRef = path.startsWith(withBase('/reference').replace(/\/+$/, ''));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
    {/* 방문 통계 (D-045): GoatCounter — 쿠키 없음, 배포 빌드에서만 넣고 localhost 방문은 스크립트가 스스로 세지 않는다 */}
    {import.meta.env.PROD && <script is:inline data-goatcounter="https://vibstudy.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={withBase('/')}>{SITE_NAME}</a>
        <nav class="site-nav" aria-label="주 메뉴">
          <a href={withBase('/')} aria-current={isHome ? 'page' : undefined}>커리큘럼</a>
          <a href={withBase('/lab/')} aria-current={isLab ? 'page' : undefined}>Signal Lab</a>
          <a href={withBase('/reference/')} aria-current={isRef ? 'page' : undefined}>레퍼런스</a>
        </nav>
      </div>
    </header>
    <main class:list={['container', { 'container-wide': wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        기계 진동 학습 아카이브 · <a href={REPO_URL}>GitHub</a>
      </div>
    </footer>
  </body>
</html>
