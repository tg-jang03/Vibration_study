---
/**
 * 본문 예시 그림 (정적 SVG, 빌드 시 렌더). 데이터 형식은 src/lib/figure.ts.
 * 사용: import Figure from '../components/content/Figure.astro';
 *       import { sineAnatomy } from '../figures/p1-0';
 *       <Figure {...sineAnatomy} />
 */
import {
  FIG_LAYOUT,
  damperSegments,
  groundSegments,
  linearScale,
  niceTicks,
  springPoints,
  type FigAnnotation,
  type FigColor,
  type FigPanel,
  type FigSeries,
} from '../../lib/figure';
import { formatNumber } from '../../lib/format';

interface Props {
  id: string;
  caption: string;
  panels: FigPanel[];
}

const { id, caption, panels } = Astro.props;

// 본문 폭(약 900px)에서 1:1로 보이도록 잡은 기준 폭. 패널 height는 680 폭 기준으로 적었으므로 HSCALE을 곱한다 (FIG_LAYOUT)
const { W, HSCALE, ML, MR } = FIG_LAYOUT;
const GAP = 14;
const COLOR: Record<FigColor, string> = {
  c1: 'var(--plot-1)',
  c2: 'var(--plot-2)',
  c3: 'var(--plot-3)',
  c4: 'var(--plot-4)',
  muted: 'var(--text-muted)',
  text: 'var(--text)',
  warn: 'var(--status-wip)',
  accent: 'var(--accent)',
};
const DEFAULT: FigColor[] = ['c1', 'c2', 'c3', 'c4'];
const f2 = (v: number) => (Number.isFinite(v) ? v.toFixed(2) : '0');
const textWidth = (s: string) => [...s].reduce((w, ch) => w + (ch.charCodeAt(0) > 0x2e80 ? 13.5 : 7.6), 0);
const tickText = (v: number) => formatNumber(v, 4);

interface Laid {
  top: number;
  height: number;
  plotTop: number;
  plotH: number;
  panel: FigPanel;
}

let offset = 0;
const laid: Laid[] = panels.map((panel) => {
  const legendItems = panel.series.filter((s) => s.label);
  const showLegend = panel.legend ?? legendItems.length > 1;
  const headH = (panel.title ? 21 : 0) + (showLegend && legendItems.length > 0 ? 22 : 0) + 8;
  const framed = panel.frame !== false;
  const hasXTicks = framed && panel.x.ticks !== 'none';
  const footH = (hasXTicks ? 22 : 4) + (framed && panel.x.label ? 20 : 0) + 4;
  const plotH = Math.round((panel.height ?? 200) * HSCALE);
  const top = offset;
  const height = headH + plotH + footH;
  offset += height + GAP;
  return { top, height, plotTop: headH, plotH, panel };
});
const H = Math.max(1, offset - GAP);

function render(l: Laid, index: number) {
  const { panel } = l;
  const plotW = W - ML - MR;
  const [x0, x1] = panel.x.range;
  const [y0, y1] = panel.y.range;
  const sx = linearScale(x0, x1, ML, ML + plotW);
  const sy = linearScale(y0, y1, l.plotTop + l.plotH, l.plotTop);
  const yBase = sy(Math.min(Math.max(0, y0), y1));
  const framed = panel.frame !== false;
  const xTicks = !framed || panel.x.ticks === 'none' ? [] : (panel.x.ticks ?? niceTicks(x0, x1, 6));
  const yTicks = !framed || panel.y.ticks === 'none' ? [] : (panel.y.ticks ?? niceTicks(y0, y1, 4));
  const label = (axisLabels: { value: number; label: string }[] | undefined, v: number) =>
    axisLabels?.find((t) => Math.abs(t.value - v) < 1e-9)?.label ?? tickText(v);

  const series = panel.series.map((s: FigSeries, i) => {
    const color = COLOR[s.color ?? DEFAULT[i % DEFAULT.length]];
    const xs = Array.from(s.x);
    const ys = Array.from(s.y);
    const kind = s.kind ?? 'line';
    let d = '';
    if (kind === 'line' || kind === 'area') {
      d = xs.map((x, j) => `${j === 0 ? 'M' : 'L'}${f2(sx(x))},${f2(sy(ys[j]))}`).join('');
      if (kind === 'area' && xs.length > 1) d += `L${f2(sx(xs[xs.length - 1]))},${f2(yBase)}L${f2(sx(xs[0]))},${f2(yBase)}Z`;
    } else if (kind === 'step') {
      d = xs
        .map((x, j) => (j === 0 ? `M${f2(sx(x))},${f2(sy(ys[j]))}` : `H${f2(sx(x))}V${f2(sy(ys[j]))}`))
        .join('');
    }
    return { kind, color, xs, ys, d, s };
  });

  const legend = panel.series
    .map((s, i) => ({ s, color: COLOR[s.color ?? DEFAULT[i % DEFAULT.length]] }))
    .filter((e) => e.s.label);
  const showLegend = (panel.legend ?? legend.length > 1) && legend.length > 0;
  let lx = ML;
  const legendY = (panel.title ? 21 : 0) + 14;
  const legendItems = showLegend
    ? legend.map((e) => {
        const item = { x: lx, ...e };
        lx += 30 + textWidth(e.s.label ?? '') + 14;
        return item;
      })
    : [];

  const arrows = (panel.annotations ?? [])
    .filter((a): a is Extract<FigAnnotation, { type: 'arrow' }> => a.type === 'arrow')
    .map((a) => {
      const p1 = [sx(a.x1), sy(a.y1)];
      const p2 = [sx(a.x2), sy(a.y2)];
      const th = Math.atan2(p2[1] - p1[1], p2[0] - p1[0]);
      const head = (tip: number[], dir: number) => {
        const bx = tip[0] - dir * 8 * Math.cos(th);
        const by = tip[1] - dir * 8 * Math.sin(th);
        return `${f2(tip[0])},${f2(tip[1])} ${f2(bx - 4 * Math.sin(th))},${f2(by + 4 * Math.cos(th))} ${f2(bx + 4 * Math.sin(th))},${f2(by - 4 * Math.cos(th))}`;
      };
      // 글자 배치: 긴 가로 화살표는 가운데 위, 짧은 가로 화살표는 오른쪽 끝 옆, 세로 화살표는 옆
      const dxPx = p2[0] - p1[0];
      const dyPx = p2[1] - p1[1];
      const tw = textWidth(a.label ?? '');
      const midX = (p1[0] + p2[0]) / 2;
      const midY = (p1[1] + p2[1]) / 2;
      let lx: number;
      let ly: number;
      let anchor: 'start' | 'middle' | 'end';
      if (Math.abs(dxPx) >= Math.abs(dyPx) && Math.abs(dxPx) > tw + 16) {
        [lx, ly, anchor] = [midX, midY - 6, 'middle'];
      } else if (Math.abs(dxPx) >= Math.abs(dyPx)) {
        [lx, ly, anchor] = [Math.max(p1[0], p2[0]) + 8, midY + 4, 'start'];
      } else if ((a.labelDx ?? 0) < 0) {
        [lx, ly, anchor] = [midX - 8, midY + 4, 'end'];
      } else {
        [lx, ly, anchor] = [midX + 8, midY + 4, 'start'];
      }
      return {
        a,
        p1,
        p2,
        color: COLOR[a.color ?? 'text'],
        heads: a.double === false ? [head(p2, 1)] : [head(p2, 1), head(p1, -1)],
        mid: [lx + (a.labelDx && anchor === 'middle' ? a.labelDx : 0), ly + (a.labelDy ?? 0)],
        anchor,
      };
    });

  // 도식 도형 (선분·스프링·감쇠기·고정면·원). 글자는 가로로 놓인 도형이면 위, 세로면 오른쪽
  type Shape = {
    color: string;
    width: number;
    dash?: boolean;
    segs?: number[][];
    poly?: string;
    circle?: { cx: number; cy: number; r: number; fill: boolean };
    text?: { x: number; y: number; anchor: 'start' | 'middle'; value: string };
  };
  const sideLabel = (p1: [number, number], p2: [number, number], half: number, value?: string): Shape['text'] => {
    if (!value) return undefined;
    const [mx, my] = [(p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2];
    return Math.abs(p2[0] - p1[0]) >= Math.abs(p2[1] - p1[1])
      ? { x: mx, y: my - half - 8, anchor: 'middle', value }
      : { x: mx + half + 8, y: my + 4, anchor: 'start', value };
  };
  const shapes: Shape[] = (panel.annotations ?? []).flatMap((a): Shape[] => {
    if (a.type === 'line') {
      return [{ color: COLOR[a.color ?? 'text'], width: a.width ?? 2, dash: a.dash, segs: [[sx(a.x1), sy(a.y1), sx(a.x2), sy(a.y2)]] }];
    }
    if (a.type === 'spring' || a.type === 'damper') {
      const p1: [number, number] = [sx(a.x1), sy(a.y1)];
      const p2: [number, number] = [sx(a.x2), sy(a.y2)];
      const w = a.width ?? (a.type === 'spring' ? 14 : 16);
      const text = sideLabel(p1, p2, w / 2, a.label);
      const color = COLOR[a.color ?? 'text'];
      return a.type === 'spring'
        ? [{ color, width: 1.8, text, poly: springPoints(p1, p2, a.coils ?? 6, w).map((q) => `${f2(q[0])},${f2(q[1])}`).join(' ') }]
        : [{ color, width: 1.8, text, segs: damperSegments(p1, p2, w) }];
    }
    if (a.type === 'ground') {
      return [{ color: COLOR[a.color ?? 'muted'], width: 1.4, segs: groundSegments([sx(a.x1), sy(a.y1)], [sx(a.x2), sy(a.y2)], a.side ?? 'left') }];
    }
    if (a.type === 'circle') {
      return [
        {
          color: COLOR[a.color ?? 'text'],
          width: 1.8,
          dash: a.dash,
          circle: { cx: sx(a.x), cy: sy(a.y), r: a.r, fill: a.fill ?? false },
          text: a.label ? { x: sx(a.x), y: sy(a.y) + 5, anchor: 'middle', value: a.label } : undefined,
        },
      ];
    }
    return [];
  });

  return { l, plotW, sx, sy, yBase, xTicks, yTicks, label, series, legendItems, legendY, arrows, shapes, framed, clipId: `${id}-clip-${index}` };
}

const rendered = laid.map(render);
---

<figure class="fig" id={id}>
  <div class="fig-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption} xmlns="http://www.w3.org/2000/svg">
      <title>{caption}</title>
      {
        rendered.map((r) => {
          const { l } = r;
          const p = l.panel;
          const top = l.plotTop;
          const bottom = l.plotTop + l.plotH;
          return (
            <g transform={`translate(0, ${l.top})`}>
              <defs>
                <clipPath id={r.clipId}>
                  <rect x={ML} y={top - 2} width={r.plotW} height={l.plotH + 4} />
                </clipPath>
              </defs>
              {p.title && (
                <text class="fig-title" x={ML} y={15}>
                  {p.title}
                </text>
              )}
              {r.legendItems.map((it) => (
                <g>
                  {it.s.kind === 'dots' || it.s.kind === 'stem' ? (
                    <circle cx={it.x + 11} cy={r.legendY - 4} r="4" style={`fill:${it.color}`} />
                  ) : it.s.kind === 'bar' || it.s.kind === 'area' ? (
                    <rect x={it.x + 4} y={r.legendY - 9} width="16" height="10" style={`fill:${it.color};opacity:0.8`} />
                  ) : (
                    <line
                      x1={it.x}
                      y1={r.legendY - 4}
                      x2={it.x + 24}
                      y2={r.legendY - 4}
                      style={`stroke:${it.color};stroke-width:2.5`}
                      stroke-dasharray={it.s.dash ? '6 4' : undefined}
                    />
                  )}
                  <text class="fig-legend" x={it.x + 30} y={r.legendY}>
                    {it.s.label}
                  </text>
                </g>
              ))}
              {/* 격자와 눈금 */}
              {r.yTicks.map((v) => (
                <g>
                  <line class="fig-grid" x1={ML} x2={ML + r.plotW} y1={f2(r.sy(v))} y2={f2(r.sy(v))} />
                  <text class="fig-tick" x={ML - 6} y={f2(r.sy(v) + 4)} text-anchor="end">
                    {r.label(p.y.tickLabels, v)}
                  </text>
                </g>
              ))}
              {r.xTicks.map((v) => (
                <g>
                  <line class="fig-grid" y1={top} y2={bottom} x1={f2(r.sx(v))} x2={f2(r.sx(v))} />
                  <text class="fig-tick" x={f2(r.sx(v))} y={bottom + 17} text-anchor="middle">
                    {r.label(p.x.tickLabels, v)}
                  </text>
                </g>
              ))}
              {r.framed && p.y.range[0] < 0 && p.y.range[1] > 0 && <line class="fig-zero" x1={ML} x2={ML + r.plotW} y1={f2(r.sy(0))} y2={f2(r.sy(0))} />}
              {r.framed && <line class="fig-axis" x1={ML} x2={ML} y1={top} y2={bottom} />}
              {r.framed && <line class="fig-axis" x1={ML} x2={ML + r.plotW} y1={bottom} y2={bottom} />}
              {r.framed && p.x.label && (
                <text class="fig-label" x={ML + r.plotW / 2} y={bottom + (p.x.ticks === 'none' ? 20 : 38)} text-anchor="middle">
                  {p.x.label}
                </text>
              )}
              {r.framed && p.y.label && (
                <text class="fig-label" transform={`translate(15, ${f2((top + bottom) / 2)}) rotate(-90)`} text-anchor="middle">
                  {p.y.label}
                </text>
              )}
              {/* 음영 구간·사각형 (계열 아래) */}
              {(p.annotations ?? []).map((a) =>
                a.type === 'band' ? (
                  <g>
                    <rect
                      x={f2(r.sx(a.x1))}
                      y={top}
                      width={f2(r.sx(a.x2) - r.sx(a.x1))}
                      height={l.plotH}
                      style={`fill:${COLOR[a.color ?? 'muted']};opacity:0.13`}
                    />
                    {a.label && (
                      <text class="fig-note" x={f2((r.sx(a.x1) + r.sx(a.x2)) / 2)} y={top + 14} text-anchor="middle" style={`fill:${COLOR[a.color ?? 'muted']}`}>
                        {a.label}
                      </text>
                    )}
                  </g>
                ) : a.type === 'rect' ? (
                  <g>
                    <rect
                      x={f2(r.sx(a.x1))}
                      y={f2(r.sy(a.y2))}
                      width={f2(r.sx(a.x2) - r.sx(a.x1))}
                      height={f2(r.sy(a.y1) - r.sy(a.y2))}
                      style={`fill:${COLOR[a.color ?? 'c1']};fill-opacity:0.18;stroke:${COLOR[a.color ?? 'c1']};stroke-width:1.2`}
                      rx="3"
                    />
                    {a.label && (
                      <text class="fig-note" x={f2((r.sx(a.x1) + r.sx(a.x2)) / 2)} y={f2((r.sy(a.y1) + r.sy(a.y2)) / 2 + 4)} text-anchor="middle">
                        {a.label}
                      </text>
                    )}
                  </g>
                ) : null,
              )}
              {/* 데이터 계열 */}
              <g clip-path={`url(#${r.clipId})`}>
                {r.series.map((s) =>
                  s.kind === 'line' || s.kind === 'step' ? (
                    <path
                      d={s.d}
                      style={`fill:none;stroke:${s.color};stroke-width:${s.s.width ?? 2};opacity:${s.s.opacity ?? 1}`}
                      stroke-dasharray={s.s.dash ? '6 4' : undefined}
                      stroke-linejoin="round"
                    />
                  ) : s.kind === 'area' ? (
                    <path d={s.d} style={`fill:${s.color};opacity:${s.s.opacity ?? 0.2};stroke:none`} />
                  ) : s.kind === 'bar' ? (
                    s.xs.map((x, j) => {
                      const w = s.s.barWidth ?? (p.x.range[1] - p.x.range[0]) / 80;
                      const yv = r.sy(s.ys[j]);
                      return (
                        <rect
                          x={f2(r.sx(x - w / 2))}
                          y={f2(Math.min(yv, r.yBase))}
                          width={f2(Math.max(1, r.sx(x + w / 2) - r.sx(x - w / 2)))}
                          height={f2(Math.abs(r.yBase - yv))}
                          style={`fill:${s.color};opacity:${s.s.opacity ?? 0.85}`}
                        />
                      );
                    })
                  ) : s.kind === 'stem' ? (
                    s.xs.map((x, j) => (
                      <g>
                        <line x1={f2(r.sx(x))} x2={f2(r.sx(x))} y1={f2(r.yBase)} y2={f2(r.sy(s.ys[j]))} style={`stroke:${s.color};stroke-width:${s.s.width ?? 2}`} />
                        <circle cx={f2(r.sx(x))} cy={f2(r.sy(s.ys[j]))} r={s.s.radius ?? 3.5} style={`fill:${s.color}`} />
                      </g>
                    ))
                  ) : (
                    s.xs.map((x, j) => <circle cx={f2(r.sx(x))} cy={f2(r.sy(s.ys[j]))} r={s.s.radius ?? 3.5} style={`fill:${s.color};opacity:${s.s.opacity ?? 1}`} />)
                  ),
                )}
              </g>
              {/* 도식 도형 (계열 위, 글자·점·화살표 아래) */}
              {r.shapes.map((sh) => (
                <g style={`stroke:${sh.color};stroke-width:${sh.width};fill:none`} stroke-linecap="round" stroke-linejoin="round">
                  {sh.segs?.map((g) => (
                    <line x1={f2(g[0])} y1={f2(g[1])} x2={f2(g[2])} y2={f2(g[3])} stroke-dasharray={sh.dash ? '6 4' : undefined} />
                  ))}
                  {sh.poly && <polyline points={sh.poly} />}
                  {sh.circle && (
                    <circle
                      cx={f2(sh.circle.cx)}
                      cy={f2(sh.circle.cy)}
                      r={f2(sh.circle.r)}
                      style={sh.circle.fill ? `fill:${sh.color};fill-opacity:0.12` : undefined}
                      stroke-dasharray={sh.dash ? '6 4' : undefined}
                    />
                  )}
                  {sh.text && (
                    <text class="fig-note fig-bold" x={f2(sh.text.x)} y={f2(sh.text.y)} text-anchor={sh.text.anchor} style={`fill:${sh.color};stroke:none`}>
                      {sh.text.value}
                    </text>
                  )}
                </g>
              ))}
              {/* 선·글자·점·화살표 주석 (계열 위) */}
              {(p.annotations ?? []).map((a) =>
                a.type === 'hline' && (a.y < p.y.range[0] || a.y > p.y.range[1]) ? null : a.type === 'vline' && (a.x < p.x.range[0] || a.x > p.x.range[1]) ? null : a.type === 'hline' ? (
                  <g>
                    <line
                      x1={ML}
                      x2={ML + r.plotW}
                      y1={f2(r.sy(a.y))}
                      y2={f2(r.sy(a.y))}
                      style={`stroke:${COLOR[a.color ?? 'muted']};stroke-width:1.4`}
                      stroke-dasharray={a.dash === false ? undefined : '5 4'}
                    />
                    {a.label && (
                      <text
                        class="fig-note"
                        x={a.labelAt === 'start' ? ML + 4 : ML + r.plotW - 4}
                        y={f2(r.sy(a.y) + (a.labelBelow ? 14 : -5))}
                        text-anchor={a.labelAt === 'start' ? 'start' : 'end'}
                        style={`fill:${COLOR[a.color ?? 'muted']}`}
                      >
                        {a.label}
                      </text>
                    )}
                  </g>
                ) : a.type === 'vline' ? (
                  <g>
                    <line
                      y1={top}
                      y2={bottom}
                      x1={f2(r.sx(a.x))}
                      x2={f2(r.sx(a.x))}
                      style={`stroke:${COLOR[a.color ?? 'muted']};stroke-width:1.4`}
                      stroke-dasharray={a.dash === false ? undefined : '5 4'}
                    />
                    {a.label && (
                      <text
                        class="fig-note"
                        x={f2(r.sx(a.x) > ML + r.plotW * 0.85 ? r.sx(a.x) - 4 : r.sx(a.x) + 4)}
                        y={top + 12}
                        text-anchor={r.sx(a.x) > ML + r.plotW * 0.85 ? 'end' : 'start'}
                        style={`fill:${COLOR[a.color ?? 'muted']}`}
                      >
                        {a.label}
                      </text>
                    )}
                  </g>
                ) : a.type === 'text' ? (
                  <text
                    class={a.bold ? 'fig-note fig-bold' : 'fig-note'}
                    x={f2(r.sx(a.x) + (a.dx ?? 0))}
                    y={f2(r.sy(a.y) + (a.dy ?? 0))}
                    text-anchor={a.anchor ?? 'start'}
                    style={`fill:${COLOR[a.color ?? 'text']}`}
                  >
                    {a.text}
                  </text>
                ) : a.type === 'point' ? (
                  <g>
                    <circle cx={f2(r.sx(a.x))} cy={f2(r.sy(a.y))} r="5" style={`fill:${COLOR[a.color ?? 'warn']};stroke:var(--surface);stroke-width:1.5`} />
                    {a.label && (
                      <text class="fig-note fig-bold" x={f2(r.sx(a.x) + (a.dx ?? 8))} y={f2(r.sy(a.y) + (a.dy ?? -8))} style={`fill:${COLOR[a.color ?? 'warn']}`}>
                        {a.label}
                      </text>
                    )}
                  </g>
                ) : null,
              )}
              {r.arrows.map((ar) => (
                <g>
                  <line x1={f2(ar.p1[0])} y1={f2(ar.p1[1])} x2={f2(ar.p2[0])} y2={f2(ar.p2[1])} style={`stroke:${ar.color};stroke-width:1.5`} />
                  {ar.heads.map((h) => (
                    <polygon points={h} style={`fill:${ar.color}`} />
                  ))}
                  {ar.a.label && (
                    <text class="fig-note fig-bold" x={f2(ar.mid[0])} y={f2(ar.mid[1])} text-anchor={ar.anchor} style={`fill:${ar.color}`}>
                      {ar.a.label}
                    </text>
                  )}
                </g>
              ))}
            </g>
          );
        })
      }
    </svg>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    margin: 1.75rem 0;
    padding: 1rem 1.1rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .fig-scroll {
    overflow-x: auto;
  }

  .fig svg {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    font-family: var(--font-sans);
  }

  figcaption {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
