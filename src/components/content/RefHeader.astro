---
/**
 * 레퍼런스 페이지(/reference/…) 공통 머리: 제목·소개·탭 (D-046).
 * 아래 `.ref-toolbar`·`.ref-chip`·`.ref-search`·`.ref-group` 모양을 레퍼런스 페이지들이 함께 쓴다.
 */
import { withBase } from '../../lib/site';
import { langOfUrl } from '../../i18n';
import { availablePath, hasEnglish } from '../../i18n/routes';
import { UI } from '../../i18n/ui';

export type RefTab = 'home' | 'sources' | 'glossary' | 'formulas';
interface Props {
  current: RefTab;
  title: string;
  lead: string;
}

const { current, title, lead } = Astro.props;
const lang = langOfUrl(Astro.url);
const t = UI[lang];
const PATHS: Record<RefTab, string> = { home: '/reference/', sources: '/reference/sources/', glossary: '/reference/glossary/', formulas: '/reference/formulas/' };
/** 영어 탭: 영어판이 있는 쪽은 /en/, 아직 없는 쪽(용어집, M12.16까지)은 한국어로 가며 KO 표시 */
const TABS = (Object.keys(PATHS) as RefTab[]).map((id) => ({
  id,
  label: t.refTabs[id],
  href: availablePath(PATHS[id], lang),
  koOnly: lang === 'en' && !hasEnglish(PATHS[id]),
}));
---

<section class="ref-hero">
  <p class="ref-kicker">{t.refKicker}</p>
  <h1>{title}</h1>
  <p class="lead">{lead}</p>
  <nav class="ref-tabs" aria-label={t.refTabsLabel}>
    {
      TABS.map((tab) => (
        <a href={withBase(tab.href)} aria-current={tab.id === current ? 'page' : undefined} hreflang={tab.koOnly ? 'ko' : undefined}>
          {tab.label}
          {tab.koOnly && <span class="ko-mark" title={t.koreanOnlyTitle}>{t.koreanOnly}</span>}
        </a>
      ))
    }
  </nav>
</section>

<style>
  .ref-hero {
    padding: 1rem 0 0.25rem;
  }

  .ref-kicker {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .ref-hero h1 {
    margin: 0.2rem 0 0.5rem;
  }

  .ref-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0.4rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }

  .ref-tabs a {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .ref-tabs a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ref-tabs a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--surface);
  }

  :global(.ref-toolbar) {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    padding: 0.6rem 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  :global(.ref-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.ref-chip) {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  :global(.ref-chip[aria-pressed='true']) {
    background: var(--c, var(--accent));
    border-color: var(--c, var(--accent));
    color: var(--surface);
  }

  :global(.ref-search) {
    flex: 1;
    min-width: 14rem;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  :global(.ref-group) {
    margin-top: 1.5rem;
  }

  :global(.ref-group > h2) {
    font-size: 1.2rem;
    margin: 0 0 0.7rem;
    padding-left: 0.6rem;
    border-left: 4px solid var(--c, var(--accent));
  }

  :global(.ref-group[hidden]),
  :global(.ref-entry[hidden]) {
    display: none;
  }

  :global(.ref-count) {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  :global(.ref-empty) {
    color: var(--text-muted);
    margin-top: 1.5rem;
  }
</style>
