---
/**
 * 본문 속 인용 표시 (D-046): [R-26, R-27]처럼 보이고, 같은 페이지 끝 "참고자료"의 그 항목으로 간다.
 * 쓰는 법 (MDX): 문장 끝에 <Cite ids={['R-26', 'R-27']} /> — ID는 그 페이지의 <References>에도 있어야 한다.
 */
import { REF_BY_ID, refAnchor } from '../../data/references';
import { langOfUrl } from '../../i18n';
import { REFERENCE_EN } from '../../i18n/figures';
import { translateText } from '../../i18n/translate';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
for (const id of ids) if (!REF_BY_ID[id]) throw new Error(`인용 ${id}가 data/references.ts에 없다`);
// 영어 페이지 (D-054): 서지 제목의 한국어는 참고자료 사전으로
const en = langOfUrl(Astro.url) === 'en';
const titleOf = (id: string) => (en ? (translateText(REF_BY_ID[id].title, REFERENCE_EN) ?? REF_BY_ID[id].title) : REF_BY_ID[id].title);
---

<span class="cite">[{ids.map((id, i) => <>{i > 0 && ', '}<a href={`#cite-${refAnchor(id)}`} title={titleOf(id)}>{id}</a></>)}]</span>

<style>
  .cite {
    font-size: 0.8em;
    white-space: nowrap;
    color: var(--text-muted);
  }

  .cite a {
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .cite a:hover {
    text-decoration: underline;
  }
</style>
