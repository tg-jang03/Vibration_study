---
import { withBase } from '../../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '');
const pages = [
  { href: '/ui-preview/', label: '홈', original: '/' },
  { href: '/ui-preview/p1-2/', label: '본문', original: '/p1-2/' },
  { href: '/ui-preview/lab/bas-01/', label: '랩', original: '/lab/bas-01/' },
];
const current = pages.find((page) => withBase(page.href).replace(/\/$/, '') === path);
---
<div class="ui-preview-bar">
  <div class="container ui-preview-bar-inner">
    <span>UI 시안</span>
    <nav aria-label="UI 시안 화면">
      {pages.map((page) => <a href={withBase(page.href)} aria-current={withBase(page.href).replace(/\/$/, '') === path ? 'page' : undefined}>{page.label}</a>)}
    </nav>
    <a class="ui-preview-original" href={withBase(current?.original ?? '/')}>기존 화면 보기 ↗</a>
  </div>
</div>
