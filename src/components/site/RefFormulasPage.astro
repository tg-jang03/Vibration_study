---
/**
 * 레퍼런스 > 기호·공식 (/reference/formulas/, /en/reference/formulas/, D-046·M12.15).
 * 본문은 언어별 MDX (한국어 reference/FormulasBody.mdx, 영어 reference/en/FormulasBody.mdx) — 카드 수·순서를 같게 둔다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RefHeader from '../content/RefHeader.astro';
import FormulasBodyKo from '../reference/FormulasBody.mdx';
import FormulasBodyEn from '../reference/en/FormulasBody.mdx';
import { localizePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T =
  lang === 'en'
    ? {
        title: 'Symbols · Formulas',
        docTitle: 'Symbols · Formulas · Reference',
        crumbs: ['Reference', 'Symbols · Formulas'],
        description:
          'The key formulas used across the site (natural frequency, damping and resonance, component frequencies, sampling, resolution, windows and scaling, phase and the 1X vector, rotor stability, defect frequencies) and the symbols, by Part, each linked to the section that explains it.',
        lead: 'Formulas you will keep coming back to, in Part order. Each symbol means the same thing everywhere on the site. Click the section number at the top right of a card to go to where the formula is first explained.',
      }
    : {
        title: '기호 · 공식',
        docTitle: '기호 · 공식 · 레퍼런스',
        crumbs: ['레퍼런스', '기호 · 공식'],
        description:
          '사이트 전체에서 쓰는 핵심 공식(고유진동수·감쇠·공진, 요소 주파수, 샘플링·분해능·윈도우·스케일링, 위상·1X 벡터, 회전체 안정성, 결함 주파수)과 기호를 Part별로 모으고 설명하는 절로 이었다.',
        lead: '자주 다시 찾게 되는 공식을 Part 순서로 모았습니다. 기호는 사이트 전체에서 같은 뜻으로 씁니다. 카드 오른쪽 위의 절 번호를 누르면 그 공식을 처음 설명한 곳으로 갑니다.',
      };
---

<BaseLayout title={T.docTitle} crumbs={[{ name: T.crumbs[0], path: localizePath('/reference/', lang) }, { name: T.crumbs[1], path: localizePath('/reference/formulas/', lang) }]} description={T.description}>
  <RefHeader current="formulas" title={T.title} lead={T.lead} />
  <div class="fx-wrap">
    {lang === 'en' ? <FormulasBodyEn /> : <FormulasBodyKo />}
  </div>
</BaseLayout>

<style>
  .fx-wrap {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr));
    column-gap: 1rem;
    align-items: start;
    line-height: 1.7;
  }

  .fx-wrap > :global(:not(article)) {
    grid-column: 1 / -1;
  }

  .fx-wrap > :global(h2) {
    font-size: 1.2rem;
    margin: 1.6rem 0 0.7rem;
    padding-left: 0.6rem;
    border-left: 4px solid var(--accent);
    scroll-margin-top: 1rem;
  }

  .fx-wrap > :global(p:first-child) {
    margin-top: 0.8rem;
  }

  .fx-wrap > :global(table) {
    border-collapse: collapse;
    width: 100%;
    max-width: 760px;
    font-size: 0.92rem;
  }

  .fx-wrap :global(th),
  .fx-wrap :global(td) {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
</style>
