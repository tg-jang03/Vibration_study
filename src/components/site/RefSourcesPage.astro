---
/**
 * 레퍼런스 > 참고 문헌 (/reference/sources/, /en/reference/sources/, D-046·M12.15).
 * 서지·쓰임·주의의 영어는 src/i18n/en/references.ts 사전 (키 = 한국어 원문), 인용한 절은 영어판이 있으면 영어로 잇는다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RefHeader from '../content/RefHeader.astro';
import RefFilter from '../content/RefFilter.astro';
import { PARTS } from '../../data/curriculum';
import { citedIds, KIND_LABEL, KIND_ORDER, REFERENCES, refAnchor, refLink, type RefKind } from '../../data/references';
import { withBase } from '../../lib/site';
import { localizePath, type Lang } from '../../i18n';
import { sectionTitle } from '../../i18n/content';
import { REFERENCE_EN } from '../../i18n/figures';
import { availablePath, sectionPath } from '../../i18n/routes';
import { translateDeep } from '../../i18n/translate';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';

const KIND_EN: Record<RefKind, string> = {
  book: 'Books',
  paper: 'Papers · reports',
  standard: 'Standards',
  web: 'Online material · manufacturer documents',
  dataset: 'Datasets',
};
const T = en
  ? {
      title: 'Sources',
      docTitle: 'Sources · Reference',
      crumbs: ['Reference', 'Sources'],
      description: 'Every book, paper, standard and online source cited on the site, in one place, each with a link to the original and to the pages that cite it.',
      lead: (pages: number, refs: number) =>
        `${refs} sources cited by ${pages} pages. The numbers (R-01 …) in the "References" list at the end of each page bring you here. For books and papers without a link to the original, "search" opens a scholarly search.`,
      kindsLabel: 'Filter by type',
      all: 'All',
      search: 'Search by title, author, topic or page (e.g. envelope, Bently, P7-5)',
      searchLabel: 'Search the sources',
      citedBy: 'Cited on',
      empty: 'No matching sources.',
      rulesTitle: 'How sources are used',
      rules: [
        'The equations, numbers and figures in the text are produced by this site’s own code. Sources are cited as the basis for concepts and context.',
        'Paid standards (ISO, API) are summarized only in intent; their text, tables and limit values are not reproduced. Read the original when you make an assessment.',
        'Manufacturer documents and public cases are summarized only as concepts; numbers and figures from those machines are not used as general criteria.',
      ],
    }
  : {
      title: '참고 문헌',
      docTitle: '참고 문헌 · 레퍼런스',
      crumbs: ['레퍼런스', '참고 문헌'],
      description: '사이트의 모든 페이지가 인용한 책·논문·규격·온라인 자료를 한곳에 모았다. 자료마다 원문 링크와 그 자료를 인용한 페이지를 붙였다.',
      lead: (pages: number, refs: number) =>
        `페이지 ${pages}곳이 인용한 자료 ${refs}개입니다. 각 페이지 끝의 "참고자료"에 붙은 번호(R-01 …)를 누르면 여기로 옵니다. 원문 링크가 없는 책·논문은 "찾아보기"가 학술 검색으로 이어집니다.`,
      kindsLabel: '종류로 거르기',
      all: '전체',
      search: '제목·저자·주제·페이지로 찾기 (예: 엔벨로프, Bently, P7-5)',
      searchLabel: '참고 문헌 찾기',
      citedBy: '인용한 페이지',
      empty: '찾는 자료가 없습니다.',
      rulesTitle: '자료를 쓰는 원칙',
      rules: [
        '본문의 수식·수치·그림은 이 사이트의 계산 코드로 직접 만들었습니다. 자료는 개념과 맥락의 근거로 인용합니다.',
        '유료 규격(ISO·API)은 취지만 요약하고 본문·표·경계값은 옮기지 않습니다. 판정에 쓸 때는 원문을 봅니다.',
        '제조사 문서·공개 사례는 개념만 요약하고, 그 기계의 수치·그림을 일반 기준으로 쓰지 않습니다.',
      ],
    };
const kindLabel = (k: RefKind) => (en ? KIND_EN[k] : KIND_LABEL[k]);
/** 서지·쓰임·주의·링크 이름 (영어는 사전으로) */
const view = (r: (typeof REFERENCES)[number]) => {
  const out = refLink(r);
  const row = { authors: r.authors, title: r.title, source: r.source, year: r.year, about: r.about, note: r.note, label: out.label };
  return { ...(en ? translateDeep(row, REFERENCE_EN) : row), href: out.href, direct: out.direct };
};

/** 페이지 MDX 원문에서 어느 절이 어느 자료를 인용했는지 모은다 (영어판은 같은 자료를 인용한다) */
const raw = import.meta.glob('../../pages/p*.mdx', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const sections = PARTS.flatMap((p) => p.sections);
const citedBy = new Map<string, { id: string; title: string; href: string; key: number }[]>();
for (const [path, text] of Object.entries(raw)) {
  const m = path.match(/p(\d+)-(\d+)\.mdx$/);
  if (!m) continue;
  const id = `P${m[1]}-${m[2]}`;
  const sec = sections.find((s) => s.id === id);
  const href = (sec && sectionPath(sec, lang)) ?? availablePath(`/p${m[1]}-${m[2]}/`, lang);
  for (const rid of new Set(citedIds(text))) {
    const list = citedBy.get(rid) ?? [];
    list.push({ id, title: sec ? sectionTitle(sec, lang) : id, href, key: Number(m[1]) * 100 + Number(m[2]) });
    citedBy.set(rid, list);
  }
}
for (const list of citedBy.values()) list.sort((a, b) => a.key - b.key);

const groups = KIND_ORDER.map((kind) => ({ kind, items: REFERENCES.filter((r) => r.kind === kind) })).filter((g) => g.items.length > 0);
const pageCount = new Set([...citedBy.values()].flat().map((p) => p.id)).size;
---

<BaseLayout title={T.docTitle} crumbs={[{ name: T.crumbs[0], path: localizePath('/reference/', lang) }, { name: T.crumbs[1], path: localizePath('/reference/sources/', lang) }]} description={T.description}>
  <RefHeader current="sources" title={T.title} lead={T.lead(pageCount, REFERENCES.length)} />

  <div class="ref-toolbar" role="search">
    <div class="ref-chips" role="group" aria-label={T.kindsLabel}>
      <button type="button" class="ref-chip" data-filter="all" aria-pressed="true">{T.all} {REFERENCES.length}</button>
      {
        groups.map((g) => (
          <button type="button" class="ref-chip" data-filter={g.kind} aria-pressed="false">
            {kindLabel(g.kind)} {g.items.length}
          </button>
        ))
      }
    </div>
    <input class="ref-search" type="search" placeholder={T.search} aria-label={T.searchLabel} />
  </div>

  {
    groups.map((g) => (
      <section class="ref-group" data-group={g.kind}>
        <h2>
          {kindLabel(g.kind)} <span class="ref-count">{g.items.length}</span>
        </h2>
        {g.kind === 'dataset' &&
          (en ? (
            <p class="src-note">
              This site does not host the data files. Check the terms of use on each institution's page, download the files, and open them only inside your browser in <a href={withBase(availablePath('/lab/data-01/', lang))}>My-file analyzer (LAB-DATA-01)</a> or <a href={withBase(availablePath('/lab/rev-01/', lang))}>Reviewing startup/shutdown records (LAB-REV-01)</a>. How to choose: <a href={withBase(availablePath('/p11-2/', lang))}>P11-2</a>.
            </p>
          ) : (
            <p class="src-note">
              이 사이트는 데이터 파일을 담지 않습니다. 각 기관 페이지에서 이용 조건을 확인하고 내려받아, <a href={withBase('/lab/data-01/')}>내 파일 분석기(LAB-DATA-01)</a>나 <a href={withBase('/lab/rev-01/')}>기록 복기(LAB-REV-01)</a>에서 브라우저 안에서만 엽니다. 고르는 법은 <a href={withBase('/p11-2/')}>P11-2</a>.
            </p>
          ))}
        <ol class="src-list">
          {g.items.map((r) => {
            const v = view(r);
            const by = citedBy.get(r.id) ?? [];
            const search = [r.id, v.authors, v.title, v.source, v.year, v.about, v.note, ...by.map((p) => `${p.id} ${p.title}`)].filter(Boolean).join(' ').toLowerCase();
            return (
              <li class="ref-entry src-item" id={refAnchor(r.id)} data-search={search}>
                <div class="src-head">
                  <span class="src-id">{r.id}</span>
                  <a class="src-out" href={v.href} target="_blank" rel="noopener noreferrer" data-direct={v.direct ? '' : undefined}>
                    {v.label} ↗
                  </a>
                </div>
                <p class="src-cite">
                  {v.authors && <span>{v.authors}, </span>}
                  {r.kind === 'book' ? <cite>{v.title}</cite> : r.kind === 'standard' ? <strong>{v.title}</strong> : <strong>“{v.title}”</strong>}
                  {v.source && <span>, {v.source}</span>}
                  {v.year && <span>, {v.year}</span>}
                  <span>.</span>
                </p>
                <p class="src-about">{v.about}</p>
                {v.note && <p class="src-note">{v.note}</p>}
                {by.length > 0 && (
                  <p class="src-pages">
                    <span class="src-pages-label">{T.citedBy}</span>
                    {by.map((p) => (
                      <a href={withBase(p.href)} title={p.title}>
                        {p.id}
                      </a>
                    ))}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
  <p class="ref-empty" hidden>{T.empty}</p>

  <section class="src-rules">
    <h2>{T.rulesTitle}</h2>
    <ul>
      {T.rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <RefFilter />
</BaseLayout>

<style>
  .src-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--gap);
  }

  .src-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    scroll-margin-top: 4.5rem;
  }

  .src-item:target {
    box-shadow: 0 0 0 3px var(--accent-soft);
    border-color: var(--accent);
  }

  .src-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .src-id {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .src-out {
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .src-out:not([data-direct]) {
    color: var(--text-muted);
  }

  .src-cite,
  .src-about,
  .src-note,
  .src-pages {
    margin: 0;
    line-height: 1.5;
  }

  .src-cite {
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .src-cite cite {
    font-weight: 600;
  }

  .src-cite strong {
    font-weight: 600;
  }

  .src-about {
    font-size: 0.86rem;
    color: var(--text-muted);
    flex: 1;
  }

  .src-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-left: 0.5rem;
    border-left: 2px solid var(--border);
  }

  .src-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
    font-size: 0.78rem;
  }

  .src-pages-label {
    color: var(--text-muted);
    margin-right: 0.15rem;
  }

  .src-pages a {
    font-family: var(--font-mono);
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
  }

  .src-pages a:hover {
    border-color: var(--accent);
  }

  .src-rules {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .src-rules h2 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .src-rules ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
