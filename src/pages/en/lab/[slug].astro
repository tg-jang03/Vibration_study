import ReviewLab from '../../../components/labs/ReviewLab';

export const getStaticPaths = (() =>
  LABS.flatMap((lab, i) =>
    hasEnglishLab(lab.component) ? [{ params: { slug: lab.slug }, props: { lab, prev: LABS[i - 1], next: LABS[i + 1] } }] : [],
  )) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lab, prev, next } = Astro.props as Props;
const c = lab.component;
