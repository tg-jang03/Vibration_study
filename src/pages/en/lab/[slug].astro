---
/**
 * 영어 랩 단독 페이지 (/en/lab/{slug}/, D-054). 영어 화면을 갖춘 랩만 만든다 — 목록은 src/i18n/routes.ts의 EN_LAB_COMPONENTS.
 * 랩을 번역하면 EN_LAB_COMPONENTS와 아래 목록에 한 줄씩 더한다 (테스트가 빠진 줄을 잡는다).
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import LabPageShell from '../../../components/site/LabPageShell.astro';
import { LABS } from '../../../data/labs';
import { hasEnglishLab } from '../../../i18n/routes';

import AafLab from '../../../components/labs/AafLab';
import AdcLab from '../../../components/labs/AdcLab';
import WindowLeakageLab from '../../../components/labs/WindowLeakageLab';
import WindowComparisonLab from '../../../components/labs/WindowComparisonLab';
import WindowCorrectionLab from '../../../components/labs/WindowCorrectionLab';
import JeffcottLab from '../../../components/labs/JeffcottLab';
import EnvelopeLab from '../../../components/labs/EnvelopeLab';
import KurtogramLab from '../../../components/labs/KurtogramLab';
import OrbitLab from '../../../components/labs/OrbitLab';
import SamplingLab from '../../../components/labs/SamplingLab';
import AmplitudeMeasuresLab from '../../../components/labs/AmplitudeMeasuresLab';
import FourierHarmonicsLab from '../../../components/labs/FourierHarmonicsLab';
import DftCorrelationLab from '../../../components/labs/DftCorrelationLab';
import ZeroPaddingLab from '../../../components/labs/ZeroPaddingLab';
import ResolutionLab from '../../../components/labs/ResolutionLab';
import SmearingLab from '../../../components/labs/SmearingLab';
import ZoomLab from '../../../components/labs/ZoomLab';
import AveragingLab from '../../../components/labs/AveragingLab';
import TsaLab from '../../../components/labs/TsaLab';
import SpectrumScalingLab from '../../../components/labs/SpectrumScalingLab';
import AmplitudeScaleLab from '../../../components/labs/AmplitudeScaleLab';
import UnitConverterLab from '../../../components/labs/UnitConverterLab';
import ModulationLab from '../../../components/labs/ModulationLab';
import SandboxLab from '../../../components/labs/SandboxLab';
import StftLab from '../../../components/labs/StftLab';
import OrderTrackingLab from '../../../components/labs/OrderTrackingLab';
import FrfLab from '../../../components/labs/FrfLab';
import FullSpectrumLab from '../../../components/labs/FullSpectrumLab';
import FilterLab from '../../../components/labs/FilterLab';
import IntegrationLab from '../../../components/labs/IntegrationLab';
import TrackingLab from '../../../components/labs/TrackingLab';
import CepstrumLab from '../../../components/labs/CepstrumLab';
import FeatureLab from '../../../components/labs/FeatureLab';
import MassSpringLab from '../../../components/labs/MassSpringLab';
import SineBasicsLab from '../../../components/labs/SineBasicsLab';
import DampingLab from '../../../components/labs/DampingLab';
import ForcedVibrationLab from '../../../components/labs/ForcedVibrationLab';
import SupportStiffnessLab from '../../../components/labs/SupportStiffnessLab';
import UnbalanceLab from '../../../components/labs/UnbalanceLab';
import TwoDofModeLab from '../../../components/labs/TwoDofModeLab';
import FrequencyMapLab from '../../../components/labs/FrequencyMapLab';
import SourceSynthesisLab from '../../../components/labs/SourceSynthesisLab';
import SensorLab from '../../../components/labs/SensorLab';
import ProximityLab from '../../../components/labs/ProximityLab';
import PhaseLab from '../../../components/labs/PhaseLab';
import SlowRollLab from '../../../components/labs/SlowRollLab';
import ChainQuizLab from '../../../components/labs/ChainQuizLab';
import AlarmLab from '../../../components/labs/AlarmLab';
import ShaftCenterlineLab from '../../../components/labs/ShaftCenterlineLab';
import StabilityLab from '../../../components/labs/StabilityLab';
import RunUpBodeLab from '../../../components/labs/RunUpBodeLab';
import TimeWaveformLab from '../../../components/labs/TimeWaveformLab';
import TrendLab from '../../../components/labs/TrendLab';
import WaterfallLab from '../../../components/labs/WaterfallLab';

export const getStaticPaths = (() =>
  LABS.flatMap((lab, i) =>
    hasEnglishLab(lab.component) ? [{ params: { slug: lab.slug }, props: { lab, prev: LABS[i - 1], next: LABS[i + 1] } }] : [],
  )) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lab, prev, next } = Astro.props as Props;
const c = lab.component;
---

<LabPageShell lang="en" lab={lab} prev={prev} next={next}>
  {c === 'SamplingLab' && <SamplingLab client:load lang="en" />}
  {c === 'AafLab' && <AafLab client:load lang="en" />}
  {c === 'AdcLab' && <AdcLab client:load lang="en" />}
  {c === 'WindowLeakageLab' && <WindowLeakageLab client:load lang="en" />}
  {c === 'WindowComparisonLab' && <WindowComparisonLab client:load lang="en" />}
  {c === 'WindowCorrectionLab' && <WindowCorrectionLab client:load lang="en" />}
  {c === 'JeffcottLab' && <JeffcottLab client:load lang="en" />}
  {c === 'EnvelopeLab' && <EnvelopeLab client:load lang="en" />}
  {c === 'KurtogramLab' && <KurtogramLab client:load lang="en" />}
  {c === 'OrbitLab' && <OrbitLab client:load lang="en" />}
  {c === 'AmplitudeMeasuresLab' && <AmplitudeMeasuresLab client:load lang="en" />}
  {c === 'FourierHarmonicsLab' && <FourierHarmonicsLab client:load lang="en" />}
  {c === 'DftCorrelationLab' && <DftCorrelationLab client:load lang="en" />}
  {c === 'ZeroPaddingLab' && <ZeroPaddingLab client:load lang="en" />}
  {c === 'ResolutionLab' && <ResolutionLab client:load lang="en" />}
  {c === 'SmearingLab' && <SmearingLab client:load lang="en" />}
  {c === 'ZoomLab' && <ZoomLab client:load lang="en" />}
  {c === 'AveragingLab' && <AveragingLab client:load lang="en" />}
  {c === 'TsaLab' && <TsaLab client:load lang="en" />}
  {c === 'SpectrumScalingLab' && <SpectrumScalingLab client:load lang="en" />}
  {c === 'AmplitudeScaleLab' && <AmplitudeScaleLab client:load lang="en" />}
  {c === 'UnitConverterLab' && <UnitConverterLab client:load lang="en" />}
  {c === 'ModulationLab' && <ModulationLab client:load lang="en" />}
  {c === 'SandboxLab' && <SandboxLab client:load lang="en" />}
  {c === 'StftLab' && <StftLab client:load lang="en" />}
  {c === 'OrderTrackingLab' && <OrderTrackingLab client:load lang="en" />}
  {c === 'FrfLab' && <FrfLab client:load lang="en" />}
  {c === 'FullSpectrumLab' && <FullSpectrumLab client:load lang="en" />}
  {c === 'FilterLab' && <FilterLab client:load lang="en" />}
  {c === 'IntegrationLab' && <IntegrationLab client:load lang="en" />}
  {c === 'TrackingLab' && <TrackingLab client:load lang="en" />}
  {c === 'CepstrumLab' && <CepstrumLab client:load lang="en" />}
  {c === 'FeatureLab' && <FeatureLab client:load lang="en" />}
  {c === 'MassSpringLab' && <MassSpringLab client:load lang="en" mode="expanded" />}
  {c === 'SineBasicsLab' && <SineBasicsLab client:load lang="en" />}
  {c === 'DampingLab' && <DampingLab client:load lang="en" />}
  {c === 'ForcedVibrationLab' && <ForcedVibrationLab client:load lang="en" />}
  {c === 'SupportStiffnessLab' && <SupportStiffnessLab client:load lang="en" />}
  {c === 'UnbalanceLab' && <UnbalanceLab client:load lang="en" />}
  {c === 'TwoDofModeLab' && <TwoDofModeLab client:load lang="en" />}
  {c === 'FrequencyMapLab' && <FrequencyMapLab client:load lang="en" />}
  {c === 'SourceSynthesisLab' && <SourceSynthesisLab client:load lang="en" />}
  {c === 'SensorLab' && <SensorLab client:load lang="en" />}
  {c === 'ProximityLab' && <ProximityLab client:load lang="en" />}
  {c === 'PhaseLab' && <PhaseLab client:load lang="en" />}
  {c === 'SlowRollLab' && <SlowRollLab client:load lang="en" />}
  {c === 'ChainQuizLab' && <ChainQuizLab client:load lang="en" />}
  {c === 'AlarmLab' && <AlarmLab client:load lang="en" />}
  {c === 'ShaftCenterlineLab' && <ShaftCenterlineLab client:load lang="en" />}
  {c === 'StabilityLab' && <StabilityLab client:load lang="en" />}
  {c === 'RunUpBodeLab' && <RunUpBodeLab client:load lang="en" />}
  {c === 'TimeWaveformLab' && <TimeWaveformLab client:load lang="en" />}
  {c === 'TrendLab' && <TrendLab client:load lang="en" />}
  {c === 'WaterfallLab' && <WaterfallLab client:load lang="en" />}
</LabPageShell>
