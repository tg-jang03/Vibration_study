---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SineBasicsLab from '../../components/labs/SineBasicsLab';
import { PARTS, STAGES, partProgress } from '../../data/curriculum';
import { withBase } from '../../lib/site';

const first = PARTS.flatMap((part) => part.sections).find((section) => section.href);
---
<BaseLayout title="학습 지도 UI 시안">
  <div class="preview-home">
    <header class="preview-intro">
      <p class="preview-eyebrow">기계 진동 학습 아카이브</p>
      <h1>기계 진동 분석과<br />회전체 진단</h1>
      <p class="preview-intro-copy">흔들림의 물리부터 신호처리, 센서, 대형 회전기계의 진단까지.<br class="preview-desktop-break" /> 그림과 수식을 읽고, 직접 값을 바꾸며 익힙니다.</p>
      <div class="preview-actions">
        {first?.href && <a class="preview-primary" href={withBase(first.href)}>처음부터 읽기 →</a>}
        <a class="preview-resume" id="preview-resume" href={withBase('/')} hidden>이어서 읽기 →</a>
        <a href="#learning-map">학습 목차</a>
      </div>
    </header>

    <section class="preview-demo" aria-labelledby="demo-title">
      <div class="preview-demo-heading">
        <div>
          <p class="preview-eyebrow">직접 해 보기</p>
          <h2 id="demo-title">주파수를 바꾸면 무엇이 달라질까요?</h2>
          <p>주파수를 5 Hz에서 10 Hz로 올려 보세요. 같은 1초 안에 물결이 두 배로 들어갑니다.</p>
        </div>
        <a href={withBase('/ui-preview/lab/bas-01/')}>전체 실험 열기 ↗</a>
      </div>
      <SineBasicsLab compact sidebar client:visible />
    </section>

    <section id="learning-map" class="preview-map" aria-labelledby="map-title">
      <header class="preview-map-heading">
        <p class="preview-eyebrow">학습 목차</p>
        <h2 id="map-title">기초에서 진단까지, 네 단계</h2>
        <p>Part 이름을 누르면 목차로 갑니다. 준비 중인 절은 절 목록에서 구별합니다.</p>
      </header>
      {STAGES.map((stage) => (
        <section class="preview-stage" aria-labelledby={`stage-${stage.num}`}>
          <header>
            <p class="preview-stage-number">단계 {String(stage.num).padStart(2, '0')}</p>
            <h3 id={`stage-${stage.num}`}>{stage.title}</h3>
            <p>{stage.summary}</p>
          </header>
          <ol class="preview-parts">
            {stage.parts.map((num) => {
              const part = PARTS.find((part) => part.num === num)!;
              const { ready, total } = partProgress(part);
              return (
                <li class="preview-part">
                  <span class="preview-part-number">Part {num}</span>
                  <div class="preview-part-content">
                    <div class="preview-part-heading">
                      <h4><a href={withBase(`/parts/${num}/`)}>{part.title}</a></h4>
                      <span class="preview-availability">{ready ? `${ready}절 읽기` : '준비 중'}</span>
                    </div>
                    <p>{part.question}</p>
                    <details class="preview-section-index">
                      <summary>절 목록 <span>{ready} / {total} 읽을 수 있음</span></summary>
                      <ol>
                        {part.sections.map((section) => (
                          <li>
                            {section.href ? (
                              <a href={withBase(section.href)}>
                                <span>{section.id.replace('P', '')}</span>{section.title}
                              </a>
                            ) : (
                              <span class="preview-section-planned">
                                <span>{section.id.replace('P', '')}</span>{section.title}<small>준비 중</small>
                              </span>
                            )}
                          </li>
                        ))}
                      </ol>
                    </details>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </section>

    <nav class="preview-resources" aria-label="학습 도구">
      <a href={withBase('/lab/')}><strong>Signal Lab ↗</strong><span>원하는 실험을 골라 직접 조작하기</span></a>
      <a href={withBase('/reference/')}><strong>레퍼런스 ↗</strong><span>참고 문헌·용어·기호와 공식 찾기</span></a>
    </nav>
  </div>
  <script is:inline>
    try {
      const last = JSON.parse(localStorage.getItem('vs-last-section-v3') || 'null');
      const resume = document.getElementById('preview-resume');
      if (last && last.href && resume) {
        resume.href = last.href;
        resume.textContent = '이어서 읽기 · ' + last.id + ' →';
        resume.hidden = false;
      }
    } catch {}
  </script>
</BaseLayout>
