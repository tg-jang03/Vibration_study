---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PARTS, partProgress } from '../data/curriculum';
import { withBase } from '../lib/site';
---

<BaseLayout>
  <h1>기계 진동 분석과 회전체 진단</h1>
  <p class="lead">
    진동의 물리와 신호처리부터 대형 회전기계(GT/ST)의 상태 진단까지, 수식·시각화·인터랙티브 실험으로 하나의 흐름 안에서 익힙니다.
  </p>

  <h2>커리큘럼 지도</h2>
  <ol class="part-grid">
    {
      PARTS.map((part) => {
        const { review, done, ready, total } = partProgress(part);
        const progressLabel = review > 0
          ? done > 0
            ? `검토 ${review} · 완료 ${done} / ${total}절`
            : `검토 ${review} / ${total}절`
          : done > 0
            ? `완료 ${done} / ${total}절`
            : `계획 / ${total}절`;
        return (
          <li>
            <a class="card part-card" href={withBase(`/parts/${part.num}/`)} data-featured={part.featured}>
              <span class="part-num">Part {part.num}</span>
              <span class="part-title">
                {part.title}
                {part.featured && <span class="star" aria-label="핵심">★</span>}
              </span>
              <span class="part-question">{part.question}</span>
              <span class="part-progress">
                <span class="bar" style={`--p:${total ? (ready / total) * 100 : 0}%`} />
                <span class="count">
                  {progressLabel}
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</BaseLayout>

<style>
  .part-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--gap);
  }

  .part-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .part-card:hover,
  .part-card:focus-visible {
    border-color: var(--accent);
  }

  .part-card[data-featured] {
    background: var(--accent-soft);
  }

  .part-num {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .part-title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .star {
    color: var(--status-wip);
    margin-left: 0.3rem;
  }

  .part-question {
    color: var(--text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .part-progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--status-done) var(--p), var(--surface-2) var(--p));
  }
</style>
